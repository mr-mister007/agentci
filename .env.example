# Admin token and first org API key. Generate with: openssl rand -hex 32
AGENTCI_BOOTSTRAP_API_KEY=
AGENTCI_BOOTSTRAP_ORG_NAME=default
AGENTCI_POSTGRES_PASSWORD=agentci

# Runtime
AGENTCI_ENVIRONMENT=prod
AGENTCI_CORS_ORIGINS=["http://localhost:4173"]
AGENTCI_PUBLIC_API_URL=http://localhost:8000

# Agent endpoint safety. Leave unset in production unless agents are internal.
# AGENTCI_ALLOW_PRIVATE_ENDPOINTS=1

# Artifacts: local (default) or s3
AGENTCI_ARTIFACT_BACKEND=local
# AGENTCI_ARTIFACT_BACKEND=s3
# AGENTCI_S3_BUCKET=
# AGENTCI_S3_ENDPOINT=
# AGENTCI_S3_REGION=us-east-1
# AGENTCI_S3_ACCESS_KEY=
# AGENTCI_S3_SECRET_KEY=

# LLM test generation (OpenAI-compatible)
# AGENTCI_LLM_API_KEY=
# AGENTCI_LLM_BASE_URL=https://api.openai.com/v1
# AGENTCI_LLM_MODEL=gpt-4o-mini

# GitHub integration
# AGENTCI_GITHUB_WEBHOOK_SECRET=
# AGENTCI_REPORT_URL=https://agentci.example.com
