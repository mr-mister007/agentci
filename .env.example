# Public ingress
AGENTCI_DOMAIN=localhost
# Use an ACME contact email for real domains, or "internal" for self-signed local certs.
AGENTCI_TLS_MODE=internal
AGENTCI_ACME_EMAIL=admin@example.com
AGENTCI_PUBLIC_API_URL=https://localhost/api

# Bootstrap admin token and first org API key. Generate with: openssl rand -hex 32
AGENTCI_BOOTSTRAP_API_KEY=
AGENTCI_BOOTSTRAP_ORG_NAME=default

# Data stores
AGENTCI_POSTGRES_PASSWORD=change-me

# Runtime
AGENTCI_ENVIRONMENT=prod
AGENTCI_MONTHLY_BUDGET_USD=25
AGENTCI_MONTHLY_RUN_QUOTA=10000

# Endpoint safety. Set to 1 only when agents are trusted internal services.
AGENTCI_ALLOW_PRIVATE_ENDPOINTS=0
AGENTCI_ALLOW_INSECURE_AGENT_ENDPOINTS=0

# Artifacts: local (default) or s3
AGENTCI_ARTIFACT_BACKEND=local
# AGENTCI_ARTIFACT_BACKEND=s3
# AGENTCI_S3_BUCKET=
# AGENTCI_S3_ENDPOINT=
# AGENTCI_S3_REGION=us-east-1
# AGENTCI_S3_ACCESS_KEY=
# AGENTCI_S3_SECRET_KEY=

# LLM test generation (OpenAI-compatible)
# AGENTCI_LLM_API_KEY=
# AGENTCI_LLM_BASE_URL=https://api.openai.com/v1
# AGENTCI_LLM_MODEL=gpt-4o-mini
# AGENTCI_LLM_TIMEOUT_SECONDS=60

# GitHub integration
# AGENTCI_GITHUB_WEBHOOK_SECRET=
# AGENTCI_REPORT_URL=https://agentci.example.com

# Optional monitoring profile
AGENTCI_WORKER_METRICS_PORT=8001
AGENTCI_GRAFANA_PASSWORD=change-me
